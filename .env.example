# AI Product Manager Copilot — environment variable template
#
# WHAT THIS FILE IS: a list of variable NAMES the project expects,
# with placeholder (non-real) values. Copy it to a real `.env` file
# and fill in your own values there.
#
# WHAT THIS FILE IS NOT: a place for real secrets. Never put an actual
# API key or database password in .env.example — this file IS meant
# to be committed to GitHub; your real `.env` is NOT (see .gitignore).
#
# HOW EACH TEAMMATE SETS THIS UP:
#   1. Copy this file:  cp .env.example .env   (Windows: copy .env.example .env)
#   2. Fill in your own real values in `.env`.
#   3. Never commit `.env` — it's already in .gitignore.

# --- AI module ---
# Milestone 2 requires ONE of the two keys below. Recommended: Gemini
# (genuinely free tier — get a key at https://aistudio.google.com/apikey).
# OpenAI works too if you already have a key, and needs no extra pip install.
# Leave both blank to run without AI analysis (Milestone 1 behavior only —
# analyze_feedback() still cleans text, ai_status will read "not_configured").
#
# NOTE: Google retires older Gemini model versions on a rolling basis.
# If AI_MODEL below starts returning 404 NOT_FOUND, list the models
# your own key currently supports and update this line:
#   python -c "from google import genai; import os; from dotenv import load_dotenv; load_dotenv(); client = genai.Client(api_key=os.environ['GEMINI_API_KEY']); [print(m.name) for m in client.models.list() if 'generateContent' in (m.supported_actions or [])]"
AI_MODEL=gemini/gemini-2.5-flash
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Database (owned by the database/backend teammate) ---
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-address>/product_assistant
MONGODB_DATABASE=product_assistant

# --- Backend (owned by the backend teammate, add as needed) ---
# BACKEND_PORT=8000
# CORS_ORIGINS=http://localhost:3000
